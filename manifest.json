{
  "manifest_version": 3,
  "name": "FPTheme",
  "version": "0.0.4",
  "description": "Расширения для добавления и редактирования тем FortPort.",
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://fortport.ru/*"],
      "css": ["style.css"]
    }
  ]
}
{
  "manifest_version": 3,
  "name": "FortPort Favorite GIFs",
  "version": "1.1",
  "description": "Закрепляет любимые гифки наверх панели FortPort",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://fortport.ru/*",
        "https://*.fortport.ru/*"
      ], 
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
